# Allow only reviewed source and documentation into this repository.
/*
!/.gitignore
!/README.md
!/LICENSE
!/SECURITY.md
!/Source/
!/docs/
/Source/*
!/Source/BooksReader.swift
!/Source/Info.plist
!/Source/build.command
/docs/*
!/docs/VALIDATION.md
!/docs/images/
/docs/images/*
!/docs/images/books-reader.png

# Local artifacts must stay private, even if placed inside an allowed folder.
.DS_Store
.AppleDouble/
._*
*.app/
dist/
.build/
*.zip
*.aiff
*.wav
*.mp3
*.m4a
*.epub
*.pdf
*.docx
*.log
.env
.env.*
*.pem
*.key
